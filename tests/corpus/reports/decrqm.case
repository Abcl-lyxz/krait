# DECRQM (T22): CSI ? Ps $ p  ->  CSI ? Ps ; Pm $ y
#
# Every answer is GENERATED from live state + the capability table
# (caps.cpp decrqmState), never hardcoded. Pm values, DEC STD 070:
#   0 not recognized   1 set   2 reset   3 permanently set   4 permanently reset
#
# The 1/2 vs 3/4 split is the honesty rule with teeth. 1 and 2 promise an
# application it can CHANGE the mode; 3 and 4 tell it the answer is fixed.
# Answering 2 for a mode we would then ignore is the same lie as answering 1.

# ---- modes we really do toggle ----

# DECOM (?6) reset by default, set after DECSET
IN \x1B[?6$p
EXPECT reply:\x1B[?6;2$y
IN \x1B[?6h\x1B[?6$p
EXPECT reply:\x1B[?6;1$y
IN \x1B[?6h\x1B[?6l\x1B[?6$p
EXPECT reply:\x1B[?6;2$y

# 1049 tracks the alternate screen
IN \x1B[?1049$p
EXPECT reply:\x1B[?1049;2$y
IN \x1B[?1049h\x1B[?1049$p
EXPECT reply:\x1B[?1049;1$y
IN \x1B[?1049h\x1B[?1049l\x1B[?1049$p
EXPECT reply:\x1B[?1049;2$y

# 2004 bracketed paste (T22): a real flag, so 1/2
IN \x1B[?2004$p
EXPECT reply:\x1B[?2004;2$y
IN \x1B[?2004h\x1B[?2004$p
EXPECT reply:\x1B[?2004;1$y
IN \x1B[?2004h\x1B[?2004l\x1B[?2004$p
EXPECT reply:\x1B[?2004;2$y

# 2026 synchronized output reports what the APPLICATION asked for. The 150 ms
# guard is a rendering safety net, not a mode change — a batch that timed out
# must not be reported back as reset, because the application still owns it.
IN \x1B[?2026$p
EXPECT reply:\x1B[?2026;2$y
IN \x1B[?2026h\x1B[?2026$p
EXPECT reply:\x1B[?2026;1$y
IN \x1B[?2026h\x1B[?2026l\x1B[?2026$p
EXPECT reply:\x1B[?2026;2$y

# ---- modes whose answer is FIXED ----

# 2027 grapheme clustering: always on by construction (T19/ADR-0003). 3, never
# 1 — answering 1 would promise an application it can turn clustering off, and
# DECRST 2027 is accept-and-ignore precisely because it cannot.
IN \x1B[?2027$p
EXPECT reply:\x1B[?2027;3$y
IN \x1B[?2027l\x1B[?2027$p
EXPECT reply:\x1B[?2027;3$y

# DECAWM (?7): we autowrap and have no path that does not, so 3. Answering 1
# would invite an application to turn wrapping off and then draw a ragged
# screen wondering why it did not take.
IN \x1B[?7$p
EXPECT reply:\x1B[?7;3$y

# DECTCEM (?25): nothing hides the cursor until the real renderer. Same rule.
IN \x1B[?25$p
EXPECT reply:\x1B[?25;3$y

# ---- everything else is 0, not a guess ----

IN \x1B[?9999$p
EXPECT reply:\x1B[?9999;0$y

# Mouse reporting answered 0 here until T27: T22 did not implement it, and
# "reset" would have told an application it could enable it. T27 implements
# 1000/1002/1003/1006 for real, so the honest answer moved to 1/2 — the block
# further down is where these modes are covered now.

# Mode 0 names nothing
IN \x1B[?0$p
EXPECT reply:\x1B[?0;0$y

# ---- malformed and near-miss forms are honest silence ----

# ANSI-mode DECRQM (no '?') is a different request we do not answer
IN \x1B[4$p
EXPECT -

# DECRQM asks about exactly ONE mode; a list is malformed, not a batch
IN \x1B[?6;1049$p
EXPECT -

# No parameter at all
IN \x1B[?$p
EXPECT -

# Colon subparameters are SGR-only
IN \x1B[?6:1$p
EXPECT -

# 'p' without the '$' intermediate is not DECRQM (DECSCL/DECSTR territory)
IN \x1B[?6p
EXPECT -

# Interrupted mid-sequence: the CAN aborts, the tail is plain text
IN \x1B[?6\x18$p
EXPECT -

# A truncated request answers nothing at all
IN \x1B[?2026$
EXPECT -

# ---- T27 input modes: DECCKM and mouse ----

# DECCKM (?1). Changes only what the KEYS send, but it is a real toggle, so 1/2
# and never 3/4 — an application that reads 3 stops trying to set it.
IN \x1B[?1$p
EXPECT reply:\x1B[?1;2$y
IN \x1B[?1h\x1B[?1$p
EXPECT reply:\x1B[?1;1$y
IN \x1B[?1h\x1B[?1l\x1B[?1$p
EXPECT reply:\x1B[?1;2$y

# Mouse tracking 1000/1002/1003 share ONE variable, so at most one is ever set.
IN \x1B[?1000$p
EXPECT reply:\x1B[?1000;2$y
IN \x1B[?1000h\x1B[?1000$p
EXPECT reply:\x1B[?1000;1$y

# Setting 1003 REPLACES 1000, and 1000 must then answer reset. Three
# independent flags would answer 1 here and the application would believe both
# are active.
IN \x1B[?1000h\x1B[?1003h\x1B[?1000$p
EXPECT reply:\x1B[?1000;2$y
IN \x1B[?1000h\x1B[?1003h\x1B[?1003$p
EXPECT reply:\x1B[?1003;1$y

# Resetting a mode that is NOT the active one changes nothing.
IN \x1B[?1003h\x1B[?1000l\x1B[?1003$p
EXPECT reply:\x1B[?1003;1$y

# Resetting the ACTIVE one turns tracking off.
IN \x1B[?1003h\x1B[?1003l\x1B[?1003$p
EXPECT reply:\x1B[?1003;2$y

# 1002 is the middle mode and behaves the same way.
IN \x1B[?1002h\x1B[?1002$p
EXPECT reply:\x1B[?1002;1$y
IN \x1B[?1002h\x1B[?1002$p
EXPECT reply:\x1B[?1002;1$y

# SGR encoding (?1006) is independent of tracking: settable before or after.
IN \x1B[?1006$p
EXPECT reply:\x1B[?1006;2$y
IN \x1B[?1006h\x1B[?1006$p
EXPECT reply:\x1B[?1006;1$y
IN \x1B[?1006h\x1B[?1000h\x1B[?1006$p
EXPECT reply:\x1B[?1006;1$y
IN \x1B[?1006h\x1B[?1000l\x1B[?1006$p
EXPECT reply:\x1B[?1006;1$y

# 1005 (UTF-8 mouse) and 1015 (urxvt mouse) are NOT implemented. Honest 0.
IN \x1B[?1005$p
EXPECT reply:\x1B[?1005;0$y
IN \x1B[?1015$p
EXPECT reply:\x1B[?1015;0$y

# ---- malformed / interrupted forms of the T27 input modes ----
# rules/vt-core.md: an escape-sequence change lands with its corpus cases in the
# same commit, and the malformed shapes matter more than the happy path — a
# parser that half-accepts one leaves state nothing can explain later.

# A mode list is malformed for DECRQM, which asks about exactly ONE mode.
IN \x1B[?1000;1002$p
EXPECT -

# CAN mid-sequence aborts it; the tail is plain text, not a second request.
IN \x1B[?1000\x18$p
EXPECT -

# SUB does the same.
IN \x1B[?1006\x1A$p
EXPECT -

# Truncated: no final byte at all.
IN \x1B[?1003$
EXPECT -

# Colon subparameters are SGR-only; not a mouse request.
IN \x1B[?1000:2$p
EXPECT -

# The ANSI (non-'?') form is a different mode space entirely, and 1000 there is
# not a mode we implement.
IN \x1B[1000$p
EXPECT -

# A DECSET with no parameter must not be read as mode 0, and must not disturb
# the mouse state a previous DECSET established.
IN \x1B[?1003h\x1B[?h\x1B[?1003$p
EXPECT reply:\x1B[?1003;1$y

# An out-of-range parameter is consumed and ignored, and leaves state alone.
IN \x1B[?1003h\x1B[?99999h\x1B[?1003$p
EXPECT reply:\x1B[?1003;1$y

# DECCKM interrupted mid-sequence leaves the mode untouched.
IN \x1B[?1\x18h\x1B[?1$p
EXPECT reply:\x1B[?1;2$y
