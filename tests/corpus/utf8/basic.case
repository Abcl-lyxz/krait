# Well-formed sequences across all lengths.
IN A
EXPECT U+0041

IN Hi
EXPECT U+0048 U+0069

# 2-byte: U+00E9 é
IN \xC3\xA9
EXPECT U+00E9

# 3-byte: Thai ก U+0E01
IN \xE0\xB8\x81
EXPECT U+0E01

# 3-byte run: สวัสดี
IN \xE0\xB8\xAA\xE0\xB8\xA7\xE0\xB8\xB1\xE0\xB8\xAA\xE0\xB8\x94\xE0\xB8\xB5
EXPECT U+0E2A U+0E27 U+0E31 U+0E2A U+0E14 U+0E35

# 4-byte: U+1F600 grinning face
IN \xF0\x9F\x98\x80
EXPECT U+1F600

# Boundary scalars
IN \x7F\xC2\x80\xEF\xBF\xBF\xF4\x8F\xBF\xBF
EXPECT U+007F U+0080 U+FFFF U+10FFFF

# ASCII interleaved with multibyte
IN a\xC3\xA9b
EXPECT U+0061 U+00E9 U+0062
