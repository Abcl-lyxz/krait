# SGR basic (0-29, 30-49, 90-107). EXPECT = pen state after feed.

# Bold + red fg
IN \x1B[1;31m
EXPECT pen:bold/1/def

# Bare CSI m resets
IN \x1B[1;31m\x1B[m
EXPECT pen:-/def/def

# Explicit SGR 0 resets
IN \x1B[31;1m\x1B[0m
EXPECT pen:-/def/def

# Every basic flag at once (underline is a style, not a flag, since T17)
IN \x1B[1;2;3;4;5;7;8;9m
EXPECT pen:bold,dim,italic,blink,rev,hide,strike/def/def ul:single/def

# 22 clears bold AND dim; 24 clears underline
IN \x1B[1;2;4m\x1B[22m\x1B[24m
EXPECT pen:-/def/def

# 23/25/27/28/29 clear their flags
IN \x1B[3;5;7;8;9m\x1B[23;25;27;28;29m
EXPECT pen:-/def/def

# Basic colors, bg too
IN \x1B[31;42m
EXPECT pen:-/1/2

# Bright range maps to 8-15
IN \x1B[91;102m
EXPECT pen:-/9/10

# 39/49 reset to default independently
IN \x1B[31;42m\x1B[39m
EXPECT pen:-/def/2

# Underline subparam: 4:0 off, 4:3 is a real curly style since T17
IN \x1B[4m\x1B[4:0m
EXPECT pen:-/def/def
IN \x1B[4:3m
EXPECT pen:-/def/def ul:curly/def

# 21 is doubly-underlined (ECMA-48 3rd, per xterm ctlseqs)
IN \x1B[21m
EXPECT pen:-/def/def ul:double/def

# Colon truecolor WITHOUT a color-space id: 4 subparams, RGB starts at the
# first. Following params still land.
IN \x1B[38:2:255:0:0;1m
EXPECT pen:bold/#ff0000/def

# Legacy semicolon 256-color form
IN \x1B[38;5;196;1m
EXPECT pen:bold/196/def

# Legacy truecolor form, and the 4 after it is a separate underline SGR
IN \x1B[38;2;10;20;30;4m
EXPECT pen:-/#0a141e/def ul:single/def

# 48 sets the background the same way
IN \x1B[48;5;22;1m
EXPECT pen:bold/def/22

# Unknown SGR ignored, neighbors still apply
IN \x1B[95;999m
EXPECT pen:-/13/def

# Truncated legacy 38 at end of sequence: nothing corrupted
IN \x1B[38;5m\x1B[31m
EXPECT pen:-/1/def

# CAN aborts an SGR mid-params: pen untouched, trailing final prints
IN \x1B[1;31\x18m
EXPECT pen:-/def/def line:1:m

# Private marker means not-SGR: rejected, pen unchanged
IN \x1B[1m\x1B[>0m
EXPECT pen:bold/def/def

# Colon 256-color form
IN \x1B[38:5:196;1m
EXPECT pen:bold/196/def
