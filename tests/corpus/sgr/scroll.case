# DECSTBM / IL / DL / SU / SD (T18). Grid is 24x80. EXPECT tokens:
#   pen:...            pen state (unchanged by this family)
#   region:T,B         1-based margins, emitted only when narrowed
#   line:N:<chars>     row content, '.' = erased cell
#
# Spec basis: vt100.net VT510 (DECSTBM "moves the cursor to column 1, line 1
# of the page"; IL/DL "no effect outside the page margins"; DL adds "blank
# lines with no visual character attributes") + xterm's charproc.c/util.c for
# everything DEC leaves unstated.

# ---- DECSTBM ----

# Sets the region and homes the cursor
IN \x1B[5;10r
EXPECT pen:-/def/def region:5,10

# Omitted Pb means the page height, so this is a full-screen region and the
# region token disappears
IN \x1B[5;10r\x1B[1r
EXPECT pen:-/def/def

# Pt < 1 clamps to 1; an oversize Pb clamps to the page height. xterm clamps
# BEFORE testing the region, so this is valid, not an error.
IN \x1B[0;999r
EXPECT pen:-/def/def

# Inverted region is IGNORED ENTIRELY — xterm's `if (bot > top)` has no else.
# The earlier region survives.
IN \x1B[5;10r\x1B[20;10r
EXPECT pen:-/def/def region:5,10

# Degenerate top == bottom is ignored the same way
IN \x1B[5;10r\x1B[7;7r
EXPECT pen:-/def/def region:5,10

# Subparams are SGR-only: rejected, so no region is set
IN \x1B[5:10r
EXPECT pen:-/def/def

# A private marker means it is not DECSTBM
IN \x1B[?5;10r
EXPECT pen:-/def/def

# ---- SU / SD ----

# Two rows of content, SU 1 pulls the second up to the first
IN A\x0D\x0AB\x1B[1S
EXPECT pen:-/def/def line:1:B

# SD pushes content down
IN A\x1B[1T
EXPECT pen:-/def/def line:2:A

# SU/SD ignore the cursor entirely — parking it outside the region changes
# nothing about what scrolls
IN \x1B[2;3r\x1B[20;1HA\x1B[2S
EXPECT pen:-/def/def region:2,3 line:20:A

# CSI 0 T is NOT SD (SD needs exactly one non-zero parameter)
IN A\x0D\x0AB\x1B[0T
EXPECT pen:-/def/def line:1:A line:2:B

# Five parameters is highlight mouse tracking, not SD
IN A\x0D\x0AB\x1B[1;2;3;4;5T
EXPECT pen:-/def/def line:1:A line:2:B

# Three parameters is neither: consumed and ignored
IN A\x0D\x0AB\x1B[1;2;3T
EXPECT pen:-/def/def line:1:A line:2:B

# Default parameter is 1
IN A\x0D\x0AB\x1B[S
EXPECT pen:-/def/def line:1:B

# A huge count clamps to the region height rather than running off the screen
IN A\x0D\x0AB\x1B[9999S
EXPECT pen:-/def/def

# ---- IL / DL ----

# IL pushes the cursor row and everything below it down
IN A\x0D\x0AB\x1B[1;1H\x1B[1L
EXPECT pen:-/def/def line:2:A line:3:B

# DL removes the cursor row and pulls the rest up
IN A\x0D\x0AB\x1B[1;1H\x1B[1M
EXPECT pen:-/def/def line:1:B

# IL/DL move the cursor to the left margin (xterm's set_cur_col(ScrnLeftMargin))
IN A\x0D\x0AB\x1B[1;5H\x1B[1M
EXPECT pen:-/def/def line:1:B

# IL/DL have NO EFFECT outside the region — the cursor here is above it
IN \x1B[10;20r\x1B[1;1HA\x1B[1M
EXPECT pen:-/def/def region:10,20 line:1:A

# Rows above the cursor stay put; only the cursor row down is affected
IN A\x0D\x0AB\x0D\x0AC\x1B[2;1H\x1B[1M
EXPECT pen:-/def/def line:1:A line:2:C

# DL of more lines than the region holds just empties it
IN A\x0D\x0AB\x1B[1;3r\x1B[1;1H\x1B[9999M
EXPECT pen:-/def/def region:1,3

# ---- interaction with the region ----

# LF at the BOTTOM MARGIN scrolls the region, not the screen. A is written on
# the bottom margin (row 2), the LF scrolls it up to row 1, then B takes row 2.
# The row below the margin (row 20) must be untouched — that is the point.
IN \x1B[20;1HZ\x1B[1;2r\x1B[2;1HA\x0D\x0AB
EXPECT pen:-/def/def region:1,2 line:1:A line:2:B line:20:Z

# ...and once the region is full, the next LF really does discard the top of it
IN \x1B[20;1HZ\x1B[1;2r\x1B[2;1HA\x0D\x0AB\x0D\x0AC
EXPECT pen:-/def/def region:1,2 line:1:B line:2:C line:20:Z

# ---- interrupted mid-sequence ----

# CAN aborts DECSTBM: no region set, the trailing final prints
IN \x1B[5;10\x18r
EXPECT pen:-/def/def line:1:r

# ESC re-introduces: the abandoned DECSTBM never applies
IN \x1B[5;10\x1B[2;4r
EXPECT pen:-/def/def region:2,4
