{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Ninja + MSVC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz (Ninja + clang-cl libFuzzer+ASan, ADR-0010 primary)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Zi",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "KRAIT_FUZZ": "ON"
      }
    },
    {
      "name": "fuzz-msvc",
      "displayName": "Fuzz (Ninja + MSVC /fsanitize=fuzzer, experimental fallback)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz-msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Zi",
        "CMAKE_CXX_COMPILER": "cl",
        "KRAIT_FUZZ": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "release (RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      },
      "description": "Optimised build with debug info. rules/render.md's perf budgets are RELEASE gates, and a Debug flood measures the compiler, not the renderer \u2014 the T25 Debug run came in at 51 fps against the same code that does 140 optimised."
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "fuzz-msvc",
      "configurePreset": "fuzz-msvc"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
